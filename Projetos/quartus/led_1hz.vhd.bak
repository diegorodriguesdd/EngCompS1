ENTITY led_1hz IS
PORT(IN_CLK: IN BIT;
OUT_CLK: OUT BIT);
END led_1hz;

ARCHITECTURE one OF led_1hz IS
SIGNAL X: BIT;
SIGNAL Y: INTEGER RANGE 0 TO 4; =0;
BEGIN
PROCESS(IN_CLK)
BEGIN
IF (IN_CLK 'EVENT) AND (IN_CLK = '1') THEN
	IF Y = 4 THEN
	Y <= 0;
	X <= NOT X;
	ELSE
	Y <= Y + 1;
	END IF
END IF
END PROCESS
OUT_CLK <= X;
END one;

