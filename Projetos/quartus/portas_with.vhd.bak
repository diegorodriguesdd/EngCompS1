ENTITY portas_with IS
PORT(A, B, C: IN BIT;
S, Ts: IN OUT);
END portas_with;

ARCHITECTURE one OF portas_with IS
SIGNAL X: BIT_VECTOR(2 DOWNTO 0);
BEGIN

WITH X SELECT
	Xa<= '1' WHEN "110",
		  '1' WHEN "111",
		  '0' WHEN OTHERS;
	
	Xb<= '0'
	Xc<= '0'
WITH X SELECT
	XD<= '1' WHEN "110",
		  '1' WHEN "111",
		  '0' WHEN OTHERS;
WITH X SELECT
	Xe<= '1' WHEN "110",
		  '1' WHEN "111",
		  '0' WHEN OTHERS;
WITH X SELECT
	Xf<= '1' WHEN "110",
		  '1' WHEN "111",
		  '0' WHEN OTHERS;
	Xg<= '1'
WITH X SELECT
	Ya<= '0' WHEN "000",
		  '0' WHEN "100",
		  '1' WHEN OTHERS;
	Yb<= '0'
	Yc<= '0'
WITH X SELECT
	Yd<= '0' WHEN "000",
		  '0' WHEN "100",
		  '0' WHEN OTHERS;
WITH X SELECT
	Ye<=  '0' WHEN "000",
		  '0' WHEN "100",
		  '0' WHEN OTHERS;
WITH X SELECT
	Yf<= '0' WHEN "000",
		  '0' WHEN "100",
		  '0' WHEN OTHERS;
WITH X SELECT
	Yg<= '1' 

END one; 

